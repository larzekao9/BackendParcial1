# Copiar a .env y ajustar. Nunca commitear el .env real.

NODE_ENV=development
# 3000 lo usa el frontend en dev (Google OAuth solo autoriza ese origen,
# ver GOOGLE_CLIENT_ID abajo) — el backend corre en otro puerto.
PORT=3333

# Postgres local (docker-compose.yml) o connection string de Supabase.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cine_ia
DB_SSL=false

# Cambiar en cualquier entorno real — nunca commitear un secreto de verdad.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_SECONDS=28800

# Client ID de Google Cloud (OAuth 2.0, tipo "Web application") — mismo
# valor que VITE_GOOGLE_CLIENT_ID en el frontend. Ver
# docs/db-schema-notes.md, "Login con Google".
GOOGLE_CLIENT_ID=

# servidor_local | maquina_local | movil_ligero — ver RF15.
NIVEL_DESPLIEGUE=servidor_local

# --- Pago con tarjeta en línea (Stripe, MODO PRUEBA) — todo esto es OPCIONAL -------------------------------------------
# Sin STRIPE_SECRET_KEY el backend arranca igual: el pago con tarjeta queda deshabilitado y solo se puede pagar en efectivo.
# Claves de prueba del Dashboard de Stripe (Developers > API keys, con el interruptor "Test mode" activado). Nunca se
# commitean y NUNCA se pegan en un chat ni en el frontend: la secreta (sk_) vive solo acá.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Firma del webhook: la imprime `stripe listen --forward-to localhost:3333/api/pagos/webhook/stripe` (whsec_...). Sin ella
# el webhook responde 503, pero el pago igual se confirma porque el navegador pide al servidor que consulte a Stripe.
STRIPE_WEBHOOK_SECRET=
# Las ventas están en bolivianos. Si Stripe no acepta "bob" en tu cuenta de prueba, cobrá en "usd" y poné acá los
# bolivianos por dólar (ej. 6.96) para convertir el total.
STRIPE_MONEDA=bob
STRIPE_TIPO_CAMBIO=

# Una venta que nadie paga se cancela y libera sus asientos pasado este tiempo (minutos). El barrido corre cada
# PAGO_BARRIDO_SEG segundos (0 = no corre).
PAGO_PENDIENTE_TTL_MIN=10
PAGO_BARRIDO_SEG=60

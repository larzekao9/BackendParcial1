# Copiar a .env y ajustar. Nunca commitear el .env real.

NODE_ENV=development
# 3000 lo usa el frontend en dev (Google OAuth solo autoriza ese origen,
# ver GOOGLE_CLIENT_ID abajo) — el backend corre en otro puerto.
PORT=3333

# Postgres local (docker-compose.yml) o connection string de Supabase.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cine_ia
DB_SSL=false

# Cambiar en cualquier entorno real — nunca commitear un secreto de verdad.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_SECONDS=28800

# Client ID de Google Cloud (OAuth 2.0, tipo "Web application") — mismo
# valor que VITE_GOOGLE_CLIENT_ID en el frontend. Ver
# docs/db-schema-notes.md, "Login con Google".
GOOGLE_CLIENT_ID=

# servidor_local | maquina_local | movil_ligero — ver RF15.
NIVEL_DESPLIEGUE=servidor_local
